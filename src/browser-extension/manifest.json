{
  "manifest_version": 3,
  "name": "MacTV 平台登录连接",
  "version": "0.2.0",
  "description": "点击后仅导入所选平台（夸克或哔哩哔哩）的登录，并由本机MacTV验证。",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://drive.quark.cn/*",
    "https://pan.quark.cn/*",
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}
